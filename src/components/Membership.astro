---
import Icon from "./icons.astro";
---
<section class="ww-section ww-membership ww-tex ww-tex--sectional" id="membership" aria-labelledby="membership-title">
  <div class="ww-container">
    <div class="ww-section-intro">
      <p class="ww-kicker">The community</p>
      <h2 id="membership-title">Support Current Heading.</h2>
    </div>

    <p class="ww-membership__intro">
      Members help fund the travel, production, and fieldwork behind Current Heading.
      Join the community and choose the membership that fits you.
    </p>

    <a class="ww-text-link" href="https://currentheading.memberful.com">
      See membership options <Icon kind="arrow" />
    </a>
  </div>
</section>

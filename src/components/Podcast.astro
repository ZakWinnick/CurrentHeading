---
import Icon from "./icons.astro";
---
<section class="ww-section ww-podcast-section ww-tex ww-tex--isobar ww-atmo ww-atmo--bloom" id="podcast" aria-labelledby="podcast-title">
  <div class="ww-container ww-podcast">
    <div class="ww-podcast__art">
      <picture>
        <source
          type="image/avif"
          srcset="/images/ground-loop-cover-480.avif 480w, /images/ground-loop-cover-800.avif 800w"
          sizes="(min-width: 760px) 35vw, 100vw"
        />
        <source
          type="image/webp"
          srcset="/images/ground-loop-cover-480.webp 480w, /images/ground-loop-cover-800.webp 800w"
          sizes="(min-width: 760px) 35vw, 100vw"
        />
        <img
          src="/images/ground-loop-cover-800.webp"
          alt="Ground Loop podcast cover"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <div class="ww-podcast__copy">
      <p class="ww-kicker">Ground Loop podcast</p>
      <h2 id="podcast-title">The conversations that need more room.</h2>
      <p>
        The audio side of Current Heading. Longer conversations about EV ownership,
        charging infrastructure, and the people shaping both.
      </p>
      <a class="ww-text-link" href="https://podcast.currentheading.com" target="_blank" rel="noopener">
        Listen to Ground Loop <Icon kind="arrow" />
      </a>
      <iframe
        class="ww-podcast__player"
        height="160"
        width="100%"
        title="Media player"
        src="https://embed.podcasts.apple.com/us/podcast/ground-loop/id1896945615?itscg=30200&amp;itsct=podcast_box_player&amp;ls=1&amp;mttnsubad=1896945615&amp;theme=auto&amp;size=small"
        id="embedPlayer"
        sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
        allow="autoplay *; encrypted-media *; clipboard-write"
        style="border: 0px; border-radius: 12px; width: 100%; height: 160px; max-width: 660px;"
      ></iframe>
    </div>
  </div>
</section>
